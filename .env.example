# Base de datos PostgreSQL externa (requerido)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Claves secretas (cambiar en producción)
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
JWT_SECRET_KEY=cambia-esta-clave-jwt-en-produccion

# Dominio(s) permitidos para CORS (tu URL en Seenode)
# Ejemplo: https://miapp.seenode.com
CORS_ORIGINS=https://tu-dominio.seenode.com
